# Copy to .env and adjust. Never commit the real .env.
UPLOAD_DIR=./tmp_uploads
REPORT_DIR=./reports
MAX_UPLOAD_MB=50
MAX_FILES=5000
# Minutes a scan lives (job, exports, temp files) before the server deletes it
SCAN_TTL_MINUTES=30
# Saved sample reports (never expire); served as a demo fallback
SAMPLES_DIR=./samples
RULES_FILE=rules/dpdp_rules.yml
LOG_LEVEL=INFO
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
GIT_CLONE_TIMEOUT=120
