# Copy to .env and adjust. Never commit the real .env.
UPLOAD_DIR=./tmp_uploads
REPORT_DIR=./reports
MAX_UPLOAD_MB=50
MAX_FILES=5000
REPORT_TTL_DAYS=7
RULES_FILE=rules/dpdp_rules.yml
LOG_LEVEL=INFO
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
GIT_CLONE_TIMEOUT=120
