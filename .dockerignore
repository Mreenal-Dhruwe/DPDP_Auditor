# Keep the build context small and free of secrets. The Dockerfile copies only what it needs.
.git
.gitignore
.gitattributes
.claude
skills-lock.json
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
.pytest_cache
.venv
venv

# Local output and uploads
tmp_uploads
reports
report
*.pdf

# Frontend: dependencies and build are recreated inside the image
frontend/node_modules
frontend/dist

# Not needed at runtime
tests
demo
scripts
*.md
!README.md
# the saved samples are served by the API
!samples/README.md

# Design reference material is not needed in the image
dpdp-design-handoff
